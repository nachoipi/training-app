# FitCore backend environment

PORT=3000

# Postgres connection string. The same app code runs against Supabase and GCP
# Cloud SQL — only this value changes when migrating.
#
# Supabase (Project Settings > Database > Connection string > URI):
#   DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
# GCP Cloud SQL for Postgres (public IP or proxy):
#   DATABASE_URL=postgresql://[USER]:[PASSWORD]@[HOST]:5432/[DBNAME]
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fitcore

# Use TLS for managed Postgres (Supabase/Cloud SQL require it). Set to false for
# a plain local Postgres without SSL.
PGSSL=true

# JWT signing secret (HS256). Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime (any value accepted by jsonwebtoken: '7d', '12h', '30m', ...)
JWT_EXPIRES_IN=7d

# Supabase Storage — athlete-side per-exercise video uploads. Leave blank to
# skip the feature (POST /api/session-logs/video will 503 with a clean error
# instead of crashing at boot). Create a bucket in Supabase Storage (public
# preferred, so <video src> plays without signed URLs) and paste its name
# into SUPABASE_VIDEO_BUCKET.
#
# SUPABASE_SERVICE_ROLE_KEY is the *service_role* JWT (Project Settings > API
# > Project API keys). It bypasses RLS — never expose it to the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_VIDEO_BUCKET=exercise-videos
